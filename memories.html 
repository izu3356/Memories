
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Memories ♡</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Georgia, serif;
    background: #fff4f4;
    color: #6d202c;
    text-align: center;
    overflow-x: hidden;
}

.hero {
    min-height: 100vh;
    padding: 55px 20px 40px;
    background:
        linear-gradient(rgba(255,244,244,.82), rgba(255,235,238,.92)),
        url("https://images.unsplash.com/photo-1494972308805-463bc619d34e?w=1200");
    background-size: cover;
    background-position: center;
}

.rose {
    font-size: 45px;
    margin-bottom: 15px;
}

h1 {
    font-size: 34px;
    letter-spacing: 3px;
    color: #8f2638;
    margin-bottom: 12px;
}

.subtitle {
    font-size: 14px;
    font-style: italic;
    color: #a45b67;
}

.line {
    width: 75px;
    height: 1px;
    background: #bd7882;
    margin: 25px auto;
}

.intro {
    max-width: 420px;
    margin: 0 auto 30px;
    font-size: 15px;
    line-height: 1.9;
    color: #78434b;
}

.memories {
    max-width: 450px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.memory {
    padding: 22px;
    background: rgba(255,255,255,.8);
    border: 1px solid #e9b9c0;
    border-radius: 3px;
    cursor: pointer;
    transition: .3s;
}

.memory:hover {
    background: #fce5e9;
    transform: translateY(-3px);
}

.memory h2 {
    font-size: 19px;
    font-weight: normal;
    color: #8f2638;
    margin-bottom: 8px;
}

.memory p {
    font-size: 13px;
    color: #a45b67;
    font-style: italic;
}

.detail {
    display: none;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid #e9b9c0;
    font-size: 14px;
    line-height: 1.9;
    color: #78434b;
}

.detail.show {
    display: block;
}

.back {
    display: inline-block;
    margin-top: 35px;
    padding: 13px 25px;
    color: #8f2638;
    text-decoration: none;
    background: rgba(255,255,255,.8);
    border: 1px solid #e9b9c0;
    transition: .3s;
}

.back:hover {
    background: #a83b4d;
    color: white;
}

footer {
    margin-top: 45px;
    font-size: 12px;
    color: #a9787e;
    letter-spacing: 1px;
}

/* Falling petals */
.petal {
    position: fixed;
    top: -30px;
    z-index: 10;
    pointer-events: none;
    animation: fall linear forwards;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(360deg);
        opacity: 0;
    }
}
</style>
</head>

<body>

<section class="hero">

    <div class="rose">🌹</div>

    <h1>Our Memories</h1>

    <p class="subtitle">
        Every little moment lives forever.
    </p>

    <div class="line"></div>

    <p class="intro">
        Some memories are written in the heart,
        never to be forgotten.
    </p>

    <div class="memories">

        <div class="memory" onclick="openMemory(1)">
            <h2>♡ The First Moment</h2>
            <p>Click to open our memory</p>
            <div id="detail1" class="detail">
                The beginning of a beautiful story.
                A moment I will always remember. 🌷
            </div>
        </div>

        <div class="memory" onclick="openMemory(2)">
            <h2>♡ Little Happiness</h2>
            <p>Click to open our memory</p>
            <div id="detail2" class="detail">
                Even the smallest moments become
                precious when they are with you. ♡
            </div>
        </div>

        <div class="memory" onclick="openMemory(3)">
            <h2>♡ Our Special Days</h2>
            <p>Click to open our memory</p>
            <div id="detail3" class="detail">
                Days may pass, but the memories
                will always stay in my heart. 🌹
            </div>
        </div>

        <div class="memory" onclick="openMemory(4)">
            <h2>♡ Somewhere by the Sea</h2>
            <p>Click to open our memory</p>
            <div id="detail4" class="detail">
                The ocean keeps its secrets,
                and the heart keeps its memories.
            </div>
        </div>

    </div>

    <a class="back" href="index.html">
        ← Back to Home
    </a>

    <footer>
        FOREVER & ETERNITY · 🌹
    </footer>

</section>

<script>
function openMemory(number) {
    const selected = document.getElementById("detail" + number);
    selected.classList.toggle("show");
}

function createPetal() {
    const petal = document.createElement("div");
    petal.className = "petal";
    petal.innerHTML = "🌸";
    petal.style.left = Math.random() * 100 + "vw";
    petal.style.fontSize = (12 + Math.random() * 12) + "px";
    petal.style.animationDuration = (5 + Math.random() * 5) + "s";

    document.body.appendChild(petal);

    setTimeout(() => {
        petal.remove();
    }, 10000);
}

setInterval(createPetal, 500);
</script>

</body>
</html>
