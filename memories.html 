
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Our Memories – Forever & Eternity 🌹</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #fff3f2;
    color: #762d3b;
    font-family: Georgia, serif;
    min-height: 100vh;
    padding: 35px 18px;
}

.container {
    max-width: 750px;
    margin: auto;
    text-align: center;
}

.rose {
    font-size: 45px;
    margin-bottom: 12px;
}

h1 {
    font-size: 34px;
    letter-spacing: 3px;
    color: #922f43;
}

.subtitle {
    margin-top: 12px;
    font-size: 14px;
    font-style: italic;
    color: #ae737c;
}

.line {
    width: 65px;
    height: 1px;
    background: #c58b91;
    margin: 25px auto;
}

.intro {
    font-size: 14px;
    line-height: 1.9;
    color: #80515a;
    margin-bottom: 35px;
}

/* Memory cards */
.memories {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.memory {
    background: #fffafa;
    border: 1px solid #edc9cb;
    padding: 12px;
    cursor: pointer;
    transition: .3s;
}

.memory:hover {
    transform: translateY(-5px);
    background: #fce7e8;
}

.memory img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
    margin-bottom: 13px;
}

.memory h2 {
    font-size: 16px;
    font-weight: normal;
    margin-bottom: 7px;
}

.memory p {
    font-size: 12px;
    color: #b17b82;
    font-style: italic;
}

/* Memory details */
.detail {
    display: none;
    background: #fffafa;
    border: 1px solid #edc9cb;
    padding: 22px;
    margin-top: 15px;
    line-height: 1.9;
    font-size: 14px;
    text-align: left;
}

.detail.show {
    display: block;
}

.back {
    display: inline-block;
    margin-top: 35px;
    padding: 12px 25px;
    color: #922f43;
    text-decoration: none;
    border: 1px solid #d9a5ac;
    transition: .3s;
}

.back:hover {
    background: #922f43;
    color: white;
}

footer {
    margin-top: 45px;
    font-size: 12px;
    color: #b17b82;
    letter-spacing: 1px;
}

@media (max-width: 480px) {
    .memories {
        grid-template-columns: 1fr;
    }

    .memory img {
        height: 220px;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="rose">🌹</div>

    <h1>Our Memories</h1>

    <p class="subtitle">
        Little moments, endless memories
    </p>

    <div class="line"></div>

    <p class="intro">
        Every picture holds a story.<br>
        Every memory deserves to be remembered.<br>
        Welcome to our little collection of moments.
    </p>

    <!-- MEMORY PHOTOS -->
    <div class="memories">

        <div class="memory" onclick="openMemory(1)">
            <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=600"
                 alt="Beautiful morning">
            <h2>♡ A beautiful day</h2>
            <p>Somewhere in time</p>
        </div>

        <div class="memory" onclick="openMemory(2)">
            <img src="https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=600"
                 alt="Flowers">
            <h2>♡ Little things</h2>
            <p>Things worth remembering</p>
        </div>

        <div class="memory" onclick="openMemory(3)">
            <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?w=600"
                 alt="Starry night">
            <h2>♡ Under the stars</h2>
            <p>A moment to keep</p>
        </div>

        <div class="memory" onclick="openMemory(4)">
            <img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=600"
                 alt="Ocean">
            <h2>♡ Somewhere by the sea</h2>
            <p>Memories never fade</p>
        </div>

    </div>

    <!-- MEMORY CONTENTS -->
    <div id="detail1" class="detail">
        <h2>♡ A beautiful day</h2>
        <p>
            Some days are ordinary, but somehow
            they become unforgettable memories.
        </p>
    </div>

    <div id="detail2" class="detail">
        <h2>♡ Little things</h2>
        <p>
            Sometimes the smallest things
            leave the biggest memories.
        </p>
    </div>

    <div id="detail3" class="detail">
        <h2>♡ Under the stars</h2>
        <p>
            Even the quietest nights
            can hold the most beautiful thoughts.
        </p>
    </div>

    <div id="detail4" class="detail">
        <h2>♡ Somewhere by the sea</h2>
        <p>
            The ocean keeps its secrets,
            and the heart keeps its memories.
        </p>
    </div>

    <a class="back" href="index.html">
        ← Back to Home
    </a>

    <footer>
        FOREVER & ETERNITY · 🌹
    </footer>

</div>

<script>
function openMemory(number) {
    const selected = document.getElementById("detail" + number);

    if (selected) {
        selected.classList.toggle("show");
    }
}
</script>

</body>
</html>
